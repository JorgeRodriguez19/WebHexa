# ------------------------------------------------------------------
#  Copia este archivo como .env y rellena los valores.
#  .env NO se versiona.
# ------------------------------------------------------------------

# --- Conexión a Postgres ---
# Opción A (local / AWS RDS): datos sueltos.
PGHOST=
PGPORT=5432
PGDATABASE=hexa
PGUSER=
PGPASSWORD=

# Opción B (Railway y otros servicios gestionados): una sola URL.
# Si está definida, tiene prioridad sobre las variables de arriba.
# DATABASE_URL=

# SSL: "on" lo exige AWS RDS; "off" para el Postgres interno de Railway.
# Si se omite, se activa salvo que el host sea interno o localhost.
# PGSSL=on

# Schema de trabajo: "development" (pruebas) o "beta" (estructura de producción).
# "public" y "test" están prohibidos: el servidor se niega a arrancar con ellos.
PGSCHEMA=development

# --- Entorno ---
# "produccion" = la base real que comparte el chatbot (avisa en rojo en la web).
# "demo"       = una copia con datos congelados, por ejemplo la de Railway.
# Si se omite, se deduce del schema.
# ENTORNO=demo

# --- Servidor ---
# En local, API_PORT evita chocar con Vite (5173). En Railway se usa PORT,
# que lo inyecta la plataforma.
API_PORT=4000

# --- Sesión ---
# Firma de los tokens. Genera uno con: openssl rand -hex 32
# Si falta, se crea uno temporal y las sesiones mueren al reiniciar.
SESION_SECRETO=

# Límite de intentos de login fallidos (por IP y por correo).
# LOGIN_MAX_INTENTOS=8
# LOGIN_VENTANA_MIN=15
